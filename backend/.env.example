# API key from https://aistudio.google.com/apikey (enable billing on the project for paid-tier limits)
GEMINI_API_KEY=
# Low-cost default. For higher extraction quality use a larger model, e.g. gemini-3.8-flash
# (`uv run python -m app.pipeline --list-models` shows what your key can use)
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order only when the main model is overloaded or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
# Seconds between calls: 2 is fine on a paid key; use 12 on the free tier
GEMINI_MIN_INTERVAL=2
# Per-request timeout in seconds
GEMINI_TIMEOUT=150
